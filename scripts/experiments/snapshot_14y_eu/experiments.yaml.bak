# snapshot_14y_eu — shortlisted experiments (reconstructed)
#
# Only the experiments that appear in the notebook shortlist screenshots
# (live entries + their non-pending siblings) are retained.
# Original 28-config matrix + ablations have been pruned down to the
# subset actually needed for the paper.

# =========================================================================
# Single-task baselines — t2m
# =========================================================================

- name: t2m_snap_era5_interp_baseline
  label: "t2m snap ERA5 interpolation (no model, K→°C)"
  colour: "#cccccc"
  target_variables: [t2m]
  extra_args: ""
  baseline_kind: era5_interp

- name: t2m_snap_persistence_baseline
  label: "t2m snap persistence (most recent valid obs ≤24h)"
  colour: "#dddddd"
  target_variables: [t2m]
  extra_args: ""
  baseline_kind: persistence

- name: t2m_snap_bilinear_baseline_wd
  label: "t2m snap bilinear baseline (with elev, with static, wd=1e-4)"
  colour: "#999999"
  target_variables: [t2m]
  extra_args: "--interpolation bilinear --weight-decay 1e-4"

- name: t2m_snap_setconv_baseline_wd
  label: "t2m snap SetConv baseline (with elev, with static, wd=1e-4)"
  colour: "#999999"
  target_variables: [t2m]
  extra_args: "--interpolation setconv --weight-decay 1e-4"


# =========================================================================
# Single-task baselines — wind (gaussian)
# =========================================================================

- name: wind_snap_era5_interp_baseline
  label: "Wind snap ERA5 interpolation (no model, sqrt(u²+v²))"
  colour: "#cccccc"
  target_variables: [wind]
  extra_args: ""
  baseline_kind: era5_interp

- name: wind_snap_persistence_baseline
  label: "Wind snap persistence (most recent valid obs ≤24h)"
  colour: "#dddddd"
  target_variables: [wind]
  extra_args: ""
  baseline_kind: persistence

- name: wind_snap_bilinear_baseline_wd
  label: "Wind snap bilinear baseline (with elev, with static, wd=1e-4)"
  colour: "#999999"
  target_variables: [wind]
  extra_args: "--interpolation bilinear --weight-decay 1e-4"

- name: wind_snap_setconv_baseline_wd
  label: "Wind snap SetConv baseline (with elev, with static, wd=1e-4)"
  colour: "#999999"
  target_variables: [wind]
  extra_args: "--interpolation setconv --weight-decay 1e-4"


# =========================================================================
# Single-task baselines — wind (weibull)
# =========================================================================

- name: wind_weibull_snap_era5_interp_baseline
  label: "Wind (Weibull) snap ERA5 interpolation (no model)"
  colour: "#cccccc"
  target_variables: [wind]
  extra_args: ""
  baseline_kind: era5_interp

- name: wind_weibull_snap_persistence_baseline
  label: "Wind (Weibull) snap persistence (most recent valid obs ≤24h)"
  colour: "#dddddd"
  target_variables: [wind]
  extra_args: ""
  baseline_kind: persistence

- name: wind_weibull_snap_bilinear_baseline_wd
  label: "Wind (Weibull) snap bilinear baseline (with elev, with static, wd=1e-4)"
  colour: "#999999"
  target_variables: [wind]
  extra_args: "--interpolation bilinear --weight-decay 1e-4 --likelihood wind=weibull"


# =========================================================================
# Single-task baselines — precip (Bernoulli-Gamma)
# =========================================================================

- name: precip_snap_era5_interp_baseline
  label: "Precip (B-G) snap ERA5 interpolation (no model)"
  colour: "#cccccc"
  target_variables: [precip]
  extra_args: ""
  baseline_kind: era5_interp

- name: precip_snap_persistence_baseline
